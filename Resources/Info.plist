<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>KEFMenuBar</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>local.kefmenubar.KEFMenuBar</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>KEF Menu Bar</string>
	<key>CFBundleDisplayName</key>
	<string>KEF Menu Bar</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 Zach Alberico. MIT License. Protocol derived from pykefcontrol (MIT).</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>KEF Menu Bar finds and controls your KEF speakers on the local network.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_kef-info._tcp</string>
	</array>
	<!-- Sparkle auto-updates. Sparkle asks before it checks automatically (on the second
	     launch); a check only fetches appcast.xml from the latest GitHub release. Updates
	     must be signed with the EdDSA key matching SUPublicEDKey (see the README). -->
	<key>SUFeedURL</key>
	<string>https://github.com/zalberico/kef-menubar/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>JMEgDbzVQlIU9k69b924/o2KP90c1e345Ktw9+FBwkA=</string>
	<key>SUEnableSystemProfiling</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Older KEF firmware only serves plain HTTP on port 80, and the speaker is
		     addressed by IP (which NSAllowsLocalNetworking does not cover). HTTPS to the
		     speaker is still pinned to the KEF CA. Must be the only ATS key: Apple
		     ignores it when NSAllowsLocalNetworking is also present. -->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>
