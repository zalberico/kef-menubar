// Settings shared by the app and the widget extension. The project sets nothing that is
// defined here, so these values (and Local.xcconfig's overrides) always apply.

// What the person sees, and the identifiers registered with Apple.
APP_DISPLAY_NAME = Speakeasy
APP_BUNDLE_ID = io.github.zalberico.Speakeasy
WIDGETS_BUNDLE_ID = $(APP_BUNDLE_ID).Widgets
APP_GROUP_ID = group.io.github.zalberico.Speakeasy
DEVELOPMENT_TEAM = 9SYNY7K2HE

MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 2

IPHONEOS_DEPLOYMENT_TARGET = 26.0
TARGETED_DEVICE_FAMILY = 1

SWIFT_VERSION = 6.0
SWIFT_DEFAULT_ACTOR_ISOLATION = nonisolated
SWIFT_APPROACHABLE_CONCURRENCY = NO

CODE_SIGN_STYLE = Automatic

// To build with your own Apple team, create iOS/Config/Local.xcconfig (it is gitignored)
// and override what you need, for example:
//   DEVELOPMENT_TEAM = ABCDE12345
//   APP_BUNDLE_ID = com.example.Speakeasy
//   APP_GROUP_ID = group.com.example.Speakeasy
#include? "Local.xcconfig"
